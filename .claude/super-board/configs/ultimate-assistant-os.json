{
  "version": 1,
  "description": "Jarvis hub — build, QA and review loop (you approve every merge)",
  "project": { "owner": "legacymiles", "title": "Jarvis Factory", "number": 0 },
  "worker_backend": "workflow",
  "calibration": { "enabled": false, "mode": "apply-existing", "skill_path": null, "allowed_skill_paths": [] },
  "model_tier": "medium",
  "codex": { "model": null },
  "target": { "type": "repo", "url": "https://ultimate-assistant-os.vercel.app" },
  "repo": { "path": ".", "remote": "https://github.com/legacymiles/ultimate-assistant-os" },
  "base_branch": "main",
  "timezone": "America/Indiana/Indianapolis",
  "columns": ["Backlog", "Ready", "Building", "QA", "Review", "Blocked", "Done"],
  "labels": ["qa", "bug", "feature", "ux", "tests", "docs", "tech-debt", "felix"],
  "paths": {
    "project_md": "CLAUDE.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": true,
  "merge_policy": {
    "default": "human",
    "auto_max_lines": 400,
    "size_exclude": [
      "**/package-lock.json", "**/generated/**", "**/__generated__/**", "**/*.generated.*",
      "**/*.min.js", "**/*.min.css", "**/*.map", "**/__snapshots__/**", "**/*.snap"
    ],
    "always_human": {
      "money": { "labels": ["money", "payments", "billing", "pricing"],
                 "paths": ["**/billing/**", "**/payments/**", "**/stripe/**", "**/checkout/**"],
                 "keywords": ["stripe.", "payment_intent", "price_id", "invoice.create"] },
      "auth": { "labels": ["auth", "security"],
                "paths": ["**/auth/**", "**/middleware.ts", "**/appGate.ts", "**/vault/**"],
                "keywords": ["service_role", "jwt.sign", "bcrypt", "password_hash"] },
      "schema": { "labels": ["schema", "destructive"],
                  "paths": [],
                  "keywords": ["drop table", "drop column", "truncate table", "rename column", "drop schema"] }
    },
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": ["supabase/migrations/**"],
    "allowed_envs": [],
    "target_env": null,
    "commands": {},
    "checks": {},
    "human_steps": ["Run new files in supabase/migrations/ in the Supabase SQL editor before merging"]
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 90,
  "usage_fallback": "none",
  "verify_commands": ["npx tsc --noEmit -p .", "npx vitest run"],
  "max_workers": 3,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "refine": {
    "dev_command": "node scripts/dev-preview.mjs $PORT --no-auth",
    "ready_path": "/apps/jarvis",
    "check_commands": ["npx tsc --noEmit -p ."],
    "env_files": [".env.local"],
    "states": [{ "name": "main" }],
    "taste_file": "DESIGN.md",
    "rounds": 5
  },
  "collect": {
    "sources": ["github", "prs", "jarvis-errors"],
    "window_days": 14,
    "prs": { "max_prs": 200 },
    "custom": [
      {
        "name": "jarvis-errors",
        "kind": "http",
        "target": "https://ultimate-assistant-os.vercel.app/api/site-errors/feed",
        "auth_env": "JARVIS_ERRORS_TOKEN",
        "map": { "items": "items", "id": "id", "title": "title", "body": "body", "url": "url", "count": "count" }
      }
    ]
  },
  "notifications": { "channel": "session", "chat_id": null, "bot_identity": "auto" }
}
