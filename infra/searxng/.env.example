# ---------------------------------------------------------------------------
# For the SearXNG box itself (VPS or laptop) — NOT for the hub.
#
# On the VPS, install.sh writes the real .env for you and generates both
# secrets. This file is the reference for what ends up in it.
#
# The hub's own variables are a different set and live in the repo root's
# .env.local (and in Vercel). See docs/search-api.md.
# ---------------------------------------------------------------------------

# A long random string SearXNG signs its sessions with. Generate one:
#   openssl rand -hex 32
SEARXNG_SECRET=

# The shared bearer token Caddy demands and the hub sends. Must be identical
# to the hub's SEARXNG_TOKEN. Generate one the same way.
# Required on a public hostname — an open instance gets found and abused.
SEARXNG_TOKEN=

# The public hostname, with an A record already pointing at this machine.
SEARXNG_HOSTNAME=search.example.com

# Must match how the instance is actually reached, or SearXNG builds wrong
# links and some engines reject the requests. Trailing slash included.
SEARXNG_BASE_URL=https://search.example.com/

# Which address the container publishes on. Leave it as loopback on the VPS —
# Caddy is the only thing that should reach SearXNG, and this is what keeps
# port 8080 off the internet even if the firewall is wrong.
SEARXNG_BIND=127.0.0.1

# uwsgi workers. One per core is plenty; install.sh sets it from nproc.
SEARXNG_WORKERS=4

# Pin the image once you are happy with a version. Default is `latest`.
# SEARXNG_IMAGE_TAG=latest
