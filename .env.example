# =====================================================================
# Projects Timeline — environment configuration
# Copy to `.env.local` and fill in. ALL values are optional: with none
# set, the app runs in local demo mode (data persists to localStorage).
# =====================================================================

# --- Supabase (optional) -------------------------------------------
# When both of these are set, the app switches from local demo mode to
# Supabase-backed storage, authentication, and file storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side identity, for the state no single viewer owns: STD Safe's
# records and share grants, and the Recall Lists board. Those live in
# public.server_docs and two private buckets, all of which have row level
# security enabled and NO policy — so the anon key above cannot read them at
# all, and the rules about who may see what stay in the route layer where
# they are actually enforceable.
#
# Unset is a supported state, not a broken one: every one of those stores
# falls back to writing files next to the project, which is right for local
# development. It is on a deployed host that the fallback fails, because the
# filesystem there is read-only — so set this in your hosting environment.
#
# NEVER prefix this NEXT_PUBLIC_. It bypasses row level security entirely,
# and that prefix would compile it into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Project Analyst (optional) ---------------------------------
# When set, "Regenerate Project" calls a real LLM through the Vercel AI
# Gateway for high-quality analysis. Without it, a built-in heuristic
# analyzer is used so the feature still works offline.
AI_GATEWAY_API_KEY=
# Model routed through the gateway (provider/model form).
AI_MODEL=anthropic/claude-sonnet-4-6

# --- Auteur on your own RunPod endpoint (optional) -------------------
# Runs the OPEN-WEIGHT MiniMax H3 on a RunPod Serverless endpoint you own,
# instead of paying MiniMax per second. Serverless (not a Pod) is the whole
# point: with its minimum worker count at zero it bills only while a job is
# actually executing, so an idle studio costs nothing.
#
# The honest catch: a cold start is billed like any other second, and H3's
# weights are tens of gigabytes, so the first render after an idle period
# pays several minutes of load time. Rendering several shots back to back is
# far cheaper per clip than rendering one and walking away.
#
# The worker image is already built and published, publicly, by GitHub Actions
# (.github/workflows/build-h3-worker.yml) to:
#     ghcr.io/<your-github-owner>/auteur-h3:latest
# so there is nothing to build. Put a key below, then run:
#
#     node runpod/setup.mjs --dry-run    # shows exactly what it would create
#     node runpod/setup.mjs --yes        # creates it, prints the endpoint id
#
# Get a key at https://console.runpod.io/user/settings
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Pin which backend Auteur renders with, instead of the default order
# (runpod -> minimax -> gateway -> placeholder).
# One of: runpod | minimax | gateway | placeholder
AUTEUR_VIDEO_BACKEND=

# --- Auteur / MiniMax H3 (optional) ----------------------------------
# Auteur renders each shot with MiniMax H3. Three backends, picked in order:
#
#   1. MINIMAX_API_KEY  — MiniMax's own v2 video API (https://platform.minimax.io).
#      Async task flow, 768P or 2K, up to 9 image + 3 video + 3 audio
#      references per shot, native audio and lip-synced dialogue. The full
#      experience; H3 costs roughly $0.08/s at 768P and $0.13/s at 2K.
#   2. AI_GATEWAY_API_KEY (from the section above) — the same model as
#      "minimax/minimax-h3" through the Vercel AI Gateway. Image references
#      only, and the render runs inside one request.
#   3. Neither — animatic placeholders. The Director, storyboard, retakes and
#      timeline all still work, so the whole workflow is usable offline.
#
# The AI Director (develop / breakdown / prompt polish / retake / reading
# reference images) also reuses AI_GATEWAY_API_KEY, with a built-in offline
# director as the fallback.
MINIMAX_API_KEY=
# Override the MiniMax model or host if they ever change.
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_API_BASE=https://api.minimax.io
# Chat model for the Director; defaults to AI_MODEL above.
AUTEUR_MODEL=

# --- Soundprint (optional) -----------------------------------------
# OpenRouter is the FREE option for the style/lyrics breakdown: the models
# in Soundprint's "Free" group (Nemotron 550B, Gemma 4, GPT-OSS) cost
# nothing and the key needs no card. Create one at https://openrouter.ai/keys
#
# Without this, Soundprint still runs: the tempo/key/percussion analysis
# happens in your browser and you get an offline prompt draft.
#
# Playback needs NO key — you create the song on Suno, paste the share link
# back, and the app plays the real Suno track from its public CDN.
OPENROUTER_API_KEY=
# Sent to OpenRouter for attribution. Optional; set it to your deployed URL.
OPENROUTER_SITE_URL=http://localhost:3000

# --- Voice Studio / TTS (optional) ---------------------------------
# Powers the Voice Studio app (fish-speech text-to-speech + voice cloning).
# Without a key, Voice Studio still runs using the browser's built-in voices
# (playback only; cloning + download need a key).
#
# fish.audio hosted API (free tier). Get a key at https://fish.audio/
FISH_API_KEY=
# Model routed to fish.audio. `s2.1-pro-free` is the free tier.
FISH_MODEL=s2.1-pro-free
#
# Backend selector: `fish-audio` (default) or `self-hosted`.
# Set `self-hosted` + TTS_SELF_HOST_URL to point at your own fish-speech
# server (its /v1/tts endpoint) instead of the hosted API.
TTS_BACKEND=fish-audio
TTS_SELF_HOST_URL=
TTS_SELF_HOST_KEY=

# --- Recall private-workspace gate (optional) ---
# Set to require a password before /apps/recall opens. Unset = open.
# This is the ADMIN password. Family members on the Lists board set their own
# when they accept an invite link, and never need this one.
RECALL_PASSWORD=

# --- Recall server-side data (optional) ---
# Where .recall-gate.json (the app-password hash) and .recall-lists.json (the
# family Lists board) are written. Defaults to the project directory, which is
# right for local dev. Point it at a mounted volume on a host whose code
# directory is read-only or rebuilt on each deploy — otherwise the board resets.
RECALL_DATA_DIR=

# --- Projects Timeline private-workspace gate (optional) ---
TIMELINE_PASSWORD=

# --- Friends Night Out (optional) ----------------------------------
# Ticketmaster Discovery API — the free tier is 5,000 calls/day and needs
# no card. Register at https://developer.ticketmaster.com/ and copy the
# Consumer Key. Without it, Friends Night Out still runs: OpenStreetMap
# (keyless) powers the Always On side, your own RSS/iCal feeds power the
# community events, and a seeded demo area keeps the app alive offline.
TICKETMASTER_API_KEY=
#
# The AI discovery sweep and the flyer/link extractor reuse AI_GATEWAY_API_KEY
# from the section above. Without it both degrade instead of failing: the
# sweep is skipped and the inbox falls back to OpenGraph/JSON-LD parsing.

# --- Dance Vault (all optional) ------------------------------------
# Dance of the Day works with NO key: a keyless YouTube trend search is
# the fallback path. A key only buys better-named picks and a reason line,
# via a web-search model (training data cannot know today.s trend).
# Reuses OPENROUTER_API_KEY from the Soundprint section above.
DANCES_MODEL=perplexity/sonar
#
# Where .dances-daily.json is written. Defaults to the project directory.
# Point it at a mounted volume on a host whose code directory is read-only
# or rebuilt on each deploy, or the daily history resets every night.
DANCES_DATA_DIR=
