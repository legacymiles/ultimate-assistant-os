# =====================================================================
# Projects Timeline — environment configuration
# Copy to `.env.local` and fill in. ALL values are optional: with none
# set, the app runs in local demo mode (data persists to localStorage).
# =====================================================================

# --- Supabase (optional) -------------------------------------------
# When both of these are set, the app switches from local demo mode to
# Supabase-backed storage, authentication, and file storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI Project Analyst (optional) ---------------------------------
# When set, "Regenerate Project" calls a real LLM through the Vercel AI
# Gateway for high-quality analysis. Without it, a built-in heuristic
# analyzer is used so the feature still works offline.
AI_GATEWAY_API_KEY=
# Model routed through the gateway (provider/model form).
AI_MODEL=anthropic/claude-sonnet-4-6
