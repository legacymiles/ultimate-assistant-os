# 24/7 Queue worker — copy to .env on the machine that runs it. Never commit .env.
# The service-role key bypasses RLS: this file must only live on the owner's own server.

# Required — the queue's database (same project as the hub).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI (planner-free, but research summaries, H3 analysis and bot write-ups use it).
# Any one of these; without them executors fall back to no-AI work and say so.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL=

# Web search chain (self-hosted SearXNG first, then DuckDuckGo, then Tavily).
SEARXNG_URL=
SEARXNG_TOKEN=
TAVILY_API_KEY=

# GitHub search for repos / MT4 sources (raises rate limits; code search needs it).
JARVIS_GITHUB_TOKEN=

# Worker identity and limits.
QUEUE_WORKER_ID=vps-1
QUEUE_CONCURRENCY=3
QUEUE_POLL_MS=5000
QUEUE_MAX_RSS_MB=1536
# Optional: restrict what this worker takes, e.g. "web,ai" (default: everything it can do).
QUEUE_CAPABILITIES=
