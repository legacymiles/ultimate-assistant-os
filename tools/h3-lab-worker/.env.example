# H3 Prompt Lab PC worker — copy this file to .env (same folder) and fill it in.
# .env is gitignored; never commit the token.

# The hub the lab lives on: http://localhost:3000 for `npm run dev`, or the deployed site.
HUB_URL=http://localhost:3000

# Mint it in the lab: /apps/h3-experiments › H3 Connection › "Create worker token". Shown once.
H3LAB_TOKEN=

# Pinokio's WanGP folder (the one holding app\wgp.py). Either ...\wan or ...\wan\app works.
WANGP_DIR=C:\pinokio\api\wan

# WanGP's MCP server. The worker starts it here if nothing is answering.
WANGP_MCP=http://127.0.0.1:42004/mcp

# Full path to ffmpeg.exe when it is not on PATH (ffprobe is taken from the same folder).
FFMPEG_PATH=

# Minutes between agent ticks while the worker has nothing else to do.
TICK_EVERY_MIN=5

# Optional:
# H3LAB_POLL_SECONDS=5      how often to ask the hub for work
# WANGP_UI_PORT=42003       Pinokio's WanGP web UI port (only checked when the process list can't be read)
# THINK_TIMEOUT_MIN=10      ceiling on one `claude -p` think job
# CLAUDE_MODEL=             model for think jobs; empty = Claude Code's default
