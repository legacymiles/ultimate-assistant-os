# dependencies
node_modules/
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# project test artifacts
.playwright-mcp/
*.png
!src/**/*.png
!public/**/*.png
# The browser extension's icon is source, not a screenshot: leaving it out means
# the deployed hub builds a download whose manifest points at a file that is not
# there, and Chrome refuses to load the whole extension over it.
!extension/**/*.png
# .claude/ is per-machine, except the super-board factory, which every machine shares.
.claude/*
!.claude/skills/
!.claude/bin/
!.claude/workflows/
!.claude/super-board/
.claude/super-board/*
!.claude/super-board/configs/


.vercel
.env*

# local backups / secrets — never push these
*.zip
claude-code-backup.zip

# Throwaway Next build dirs (preview servers, verification, deploy checks).
.next-*
.preview-data-*

# Recall app password (salted hash, never the plaintext)
.recall-gate.json
.recall-lists.json
.site-errors.json

# STD Safe — accounts, results, and the uploaded lab reports.
# Real health records with names and dates of birth on them. Never commit these.
.std-safe.json
.std-safe.json.probe
std-safe-reports/

# Dance Vault — daily picks + cached clips
.dances-daily.json
public/dances/
# Dance Studio — local-disk library + media (production uses Supabase)
.dance-studio-*

# Game Creator — local-disk games document + screenshots (production uses Supabase)
.data/

# Scratch Overpass queries
*.osm

# Supabase CLI scratch (version probe, linked-project cache).
supabase/.temp/
__pycache__/

# Loose screenshots and local tool logs — CLAUDE.md documents docs/screenshots
# as gitignored, but it never was, so 7MB of stills sat untracked in the tree.
docs/screenshots/
tools/unreal-builder/builder.log

# Panels and cast sheets dumped out of a Studio session to be looked at. The
# route that writes them (src/app/api/dumpimages) is local debug scaffolding and
# is deliberately not committed: it would be an unauthenticated write endpoint.
public/__dump/

# Studio bridge renders and reference photos (local only)
/tools/studio-bridge/out/

# cobalt is cloned, not vendored (tools/cobalt/install.mjs)
/tools/cobalt/app/
/tools/cobalt/out/

# Derived by graphify, regenerate with: graphify . --out graphify-out --code-only
graphify-out/

